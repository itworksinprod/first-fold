{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-fold-morning-dispatcher",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "triggers": {
    "crons": [
      "5 9 * * *",
      "5 10 * * *",
      "0 10 * * *",
      "0 11 * * *"
    ]
  }
}
